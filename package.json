{
  "name": "tick",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Minimal self-hosted time tracker for freelancers.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch --disable-warning=ExperimentalWarning server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
